if [ "${DIRENV_SKIP_FLAKE:-}" != "1" ]; then
  use flake
fi

# Load local environment variables for testing (see .envrc.example).
# In secondary git worktrees, load .envrc.local from the main repository first.
main_git_dir="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -n "$main_git_dir" ] && [ "$main_git_dir" != "$repo_root/.git" ]; then
  source_env_if_exists "$main_git_dir/../.envrc.local"
fi

# Allow local overrides in the current worktree
source_env_if_exists .envrc.local
