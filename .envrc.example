# Copy this file to .envrc.local and fill in your values
# Then add 'source_env_if_exists .envrc.local' to your .envrc

export TF_ACC=1
export DOIT_API_TOKEN="your-api-token"
export DOIT_HOST="https://api.doit.com"
# export DOIT_REQUEST_TIMEOUT="150s"
export TEST_USER="your-email@example.com"
export TEST_USER_2="second-user@example.com"
export TEST_ATTRIBUTION="your-attribution-id"
export TEST_PROJECT="your-project-id"
export TEST_CUSTOMER_ID="your-customer-id"

# Optional - specific resource and data source tests will be skipped if these are unset
# export TEST_ATTRIBUTION_GROUP="your-attribution-group-id"
# export TEST_INVOICE_ID="your-invoice-id"
# export TEST_INVOICE_ID_CANCELED="your-canceled-invoice-id"
# export TEST_SLACK_CHAN="your-slack-channel-id"
# export TEST_SLACK_WORKSPACE="your-slack-workspace"
# export TEST_SLACK_WORKSPACE_CHAN="your-slack-workspace-channel-id"
# export TEST_BILLING_EXPLAINER_INVOICE_MONTH="your-invoice-month"  # format YYYY-MM
# export TEST_ANOMALY_ID="your-anomaly-id"
# export TEST_CLOUD_INCIDENT_ID="your-cloud-incident-id"
# export TEST_COMMITMENT_ID="your-commitment-id"
# export TEST_DASHBOARD_ID="your-dashboard-id"  # no API lists dashboards; copy an ID from the console URL
# export TEST_BILLING_PROFILE_ID="your-billing-profile-id"  # no API lists billing profiles; copy the ID from the console URL (not the number shown in the UI)
# export TEST_ASSET_ID="your-asset-id"
# export TEST_ASSET_ID_AWS="your-aws-asset-id"
# export TEST_ASSET_ID_GCP="your-google-cloud-asset-id"
# export TEST_CLOUD_DIAGRAM_RESOURCE="//compute.googleapis.com/projects/your-project/global/networks/your-network"
# export TEST_DATAHUB_DATASET="your-datahub-dataset-name"
# export TEST_INVITE_EMAIL="user+ci-test@example.com"
# export TEST_AWS_ACCOUNT_ID="your-aws-account-id"
# export TEST_AWS_ROLE_ARN="arn:aws:iam::your-account-id:role/your-role-name"
# export TEST_AWS_S3_BUCKET="your-s3-bucket-name"
# export TEST_AWS_S3_BUCKET_REGION="us-east-1"
# export TEST_GCP_PROJECT_ID="your-gcp-project-id"
# export TEST_GCP_SERVICE_ACCOUNT_EMAIL="your-sa@your-gcp-project-id.iam.gserviceaccount.com"  # holds the roles from doit_cloudconnect_gcp_requirements; one connection per service account
# export TEST_GCP_SERVICE_ACCOUNT_UNIQUE_ID="your-service-account-unique-id"
# export TEST_GCP_BIGQUERY_FINOPS="1"  # set when the service account can enable BigQuery FinOps on the project
# export TEST_GCP_BILLING_ACCOUNT_ID="your-billing-account-id"  # not connected to DoiT; roles from doit_billing_gcp_requirements granted
# export TEST_GCP_BILLING_EXPORT_PROJECT="your-billing-export-project-id"
# export TEST_GCP_BILLING_EXPORT_DATASET="your-billing-export-dataset"

# DoiT employees only - uncomment the following line:
# export DOIT_CUSTOMER_CONTEXT="$TEST_CUSTOMER_ID"
